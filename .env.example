# Copy to .env for local development (.env is gitignored). Local values only.

DATAFORGE_ENV=dev
DATAFORGE_MASKING_KEY=local-dev-key-not-a-secret
DATAFORGE_MASKING_KEY_VERSION=v1

AIRFLOW_JWT_SECRET=local-dev-jwt-secret-change-me
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Deployed environments read these from the secrets backend, not env vars.
# DATAFORGE_API_TOKEN=

# ---------------------------------------------------------------------------------
# Emulated AWS (Floci / LocalStack / MinIO). Set these to run the cloud code paths.
# Use localhost from the host and the service name from inside a container.
# ---------------------------------------------------------------------------------
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_DEFAULT_REGION=us-east-1

# Storage roots accept a bare path, file:// or s3://.
# DATAFORGE_LAKE_ROOT=s3://dataforge-lake/warehouse
# DATAFORGE_LANDING_ROOT=s3://dataforge-landing

# Load the masking key from the secrets backend (as in prod). Wins over DATAFORGE_MASKING_KEY.
# DATAFORGE_MASKING_KEY_SECRET_REF=secret://dataforge/masking-key
